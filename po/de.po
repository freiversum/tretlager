msgstr "Sensor-Bridge prüfen"

#: tretlager/core/launch.py:221
msgid "Checking the sign-in"
msgstr "Anmeldung prüfen"

#: tretlager/core/launch.py:229
#, python-brace-format
msgid "Wine DPI adjusted to the screen: {dpi}"
msgstr "Wine-DPI an den Bildschirm angepasst: {dpi}"

#: tretlager/core/launch.py:230
msgid "Start Zwift"
msgstr "Zwift starten"

#: tretlager/core/launch.py:233
msgid "Adjusting the window"
msgstr "Fenster anpassen"

#: tretlager/core/launch.py:235 tretlager/kde/app.py:773
msgid "Zwift is running"
msgstr "Zwift läuft"

#: tretlager/core/launch.py:242
msgid ""
"Sensors come through the Zwift Companion app, the sensor bridge stays off"
msgstr ""
"Sensoren kommen über die Zwift Companion App, die Sensor-Bridge bleibt aus"

#: tretlager/core/launch.py:245
msgid "Sensor bridge not installed, starting without sensors"
msgstr "Sensor-Bridge nicht installiert, Start ohne Sensoren"

#: tretlager/core/launch.py:249
msgid "Sensor bridge started"
msgstr "Sensor-Bridge gestartet"

#: tretlager/core/launch.py:256
msgid "Zwift set to search for sensors through the Companion app"
msgstr "Zwift auf Sensorsuche über die Companion App gestellt"

#: tretlager/core/launch.py:257
msgid "Zwift set back to its own Bluetooth search"
msgstr "Zwift wieder auf die eigene Bluetooth-Suche gestellt"

#: tretlager/core/launch.py:259
#, python-brace-format
msgid "Could not adjust Zwift's sensor setting: {error}"
msgstr "Die Sensoreinstellung von Zwift ließ sich nicht anpassen: {error}"

#: tretlager/core/launch.py:271
msgid "New Wine with Tretlager: back to the bundled version"
msgstr "Neues Wine mit Tretlager: wieder mit der mitgelieferten Version"

#: tretlager/core/launch.py:277 tretlager/core/launch.py:278
#, python-brace-format
msgid "Completing setup: {step}"
msgstr "Einrichtung ergänzen: {step}"

#: tretlager/core/launch.py:282
msgid "Check setup"
msgstr "Einrichtung prüfen"

#: tretlager/core/launch.py:284
msgid "The setup could not be checked."
msgstr "Die Einrichtung ließ sich nicht abgleichen."

#: tretlager/core/launch.py:291
#, python-brace-format
msgid "Could not check for updates: {error}"
msgstr "Update-Prüfung nicht möglich: {error}"

#: tretlager/core/launch.py:298
#, python-brace-format
msgid "Updating Zwift ({old} → {new})"
msgstr "Zwift wird aktualisiert ({old} → {new})"

#: tretlager/core/launch.py:302
#, python-brace-format
msgid "Zwift update: {gb} GB to download"
msgstr "Zwift-Update: {gb} GB zu laden"

#: tretlager/core/launch.py:315
#, python-brace-format
msgid "{title}: {done} of {total} GB"
msgstr "{title}: {done} von {total} GB"

#: tretlager/core/launch.py:319
#, python-brace-format
msgid "{title}, for {n} minute"
msgid_plural "{title}, for {n} minutes"
msgstr[0] "{title}, seit {n} Minute"
msgstr[1] "{title}, seit {n} Minuten"

#: tretlager/core/launch.py:322
#, python-brace-format
msgid "Zwift updated to {version}"
msgstr "Zwift aktualisiert auf {version}"

#: tretlager/core/launch.py:325
msgid ""
"The Zwift update did not finish. Tretlager continues it on the next start."
msgstr ""
"Das Zwift-Update wurde nicht fertig. Beim nächsten Start setzt Tretlager es "
"fort."

#: tretlager/core/launch.py:342
msgid "Could not compile the start helper."
msgstr "Hilfsprogramm zum Starten ließ sich nicht übersetzen."

#: tretlager/core/launch.py:354
msgid "GNOME: \"not responding\" check switched off while Zwift runs"
msgstr "GNOME: Prüfung auf „reagiert nicht“ ausgeschaltet, solange Zwift läuft"

#: tretlager/core/launch.py:378
msgid "The Zwift launcher does not start."
msgstr "Der Zwift-Launcher startet nicht."

#: tretlager/core/launch.py:395
#, python-brace-format
msgid "Could not start Zwift (RunFromProcess, code {code})."
msgstr "Zwift ließ sich nicht starten (RunFromProcess, Code {code})."

#: tretlager/core/launch.py:398
msgid "Could not start Zwift (timed out)."
msgstr "Zwift ließ sich nicht starten (Zeitüberschreitung)."

#: tretlager/core/launch.py:415
msgid "Could not maximise the Zwift window"
msgstr "Das Zwift-Fenster ließ sich nicht maximieren"

#: tretlager/core/launch.py:432
msgid "Sensor bridge stopped"
msgstr "Sensor-Bridge gestoppt"

#: tretlager/core/login.py:62
msgid "The sign-in was cancelled."
msgstr "Die Anmeldung wurde abgebrochen."

#: tretlager/core/login.py:63 tretlager/core/login.py:64
msgid ""
"Zwift requires signing in with email and password. Please sign in again."
msgstr ""
"Zwift verlangt eine Anmeldung mit E-Mail und Passwort. Bitte erneut anmelden."

#: tretlager/core/login.py:65
msgid "Zwift sign-in is unavailable right now. Please try again later."
msgstr ""
"Die Zwift-Anmeldung ist gerade nicht erreichbar. Bitte später erneut "
"versuchen."

#: tretlager/core/login.py:66
msgid "Zwift sign-in reported an error. Please try again later."
msgstr ""
"Bei der Zwift-Anmeldung ist ein Fehler aufgetreten. Bitte später erneut "
"versuchen."

#: tretlager/core/login.py:71
#, python-brace-format
msgid ""
"Zwift did not complete the sign-in (error “{code}”). Please sign in again."
msgstr ""
"Zwift hat die Anmeldung nicht abgeschlossen (Fehler „{code}“). Bitte erneut "
"anmelden."

#: tretlager/core/login.py:79
msgid ""
"This is not the address shown after signing in to Zwift (launcher.zwift.com/"
"launcher?…)."
msgstr ""
"Das ist nicht die Adresse nach der Zwift-Anmeldung (launcher.zwift.com/"
"launcher?…)."

#: tretlager/core/login.py:85
msgid "The address is missing the sign-in code (code=…)."
msgstr "In der Adresse fehlt der Anmeldecode (code=…)."

#: tretlager/core/login.py:87
msgid ""
"The address belongs to an earlier sign-in. Please sign in again in the "
"browser."
msgstr ""
"Die Adresse gehört zu einer älteren Anmeldung. Bitte erneut im Browser "
"anmelden."

#: tretlager/core/login.py:99
msgid "Zwift rejected the sign-in (code expired or already used)."
msgstr ""
"Zwift hat die Anmeldung abgelehnt (Code abgelaufen oder bereits benutzt)."

#: tretlager/core/login.py:100
#, python-brace-format
msgid "Zwift sign-in unreachable (HTTP {code})."
msgstr "Zwift-Anmeldung nicht erreichbar (HTTP {code})."

#: tretlager/core/login.py:102
msgid "Zwift sign-in unreachable. Is there an internet connection?"
msgstr "Zwift-Anmeldung nicht erreichbar. Besteht eine Internetverbindung?"

#: tretlager/core/login.py:104
msgid "Unexpected response from Zwift."
msgstr "Unerwartete Antwort von Zwift."

#: tretlager/core/login.py:127
#, python-brace-format
msgid "Signing out of Zwift failed (HTTP {code})."
msgstr "Abmelden bei Zwift fehlgeschlagen (HTTP {code})."

#: tretlager/core/login.py:129
msgid "Zwift sign-in unreachable; signed out locally."
msgstr "Zwift-Anmeldung nicht erreichbar; lokal abgemeldet."

#: tretlager/core/login.py:161
msgid ""
"python3-secretstorage is missing; without a keyring Tretlager does not store "
"a token."
msgstr ""
"python3-secretstorage fehlt; ohne Schlüsselbund speichert Tretlager kein "
"Token."

#: tretlager/core/login.py:168
msgid "The keyring is locked. Unlock the keyring to start Zwift."
msgstr ""
"Der Schlüsselbund ist gesperrt. Zum Starten von Zwift den Schlüsselbund "
"entsperren."

#: tretlager/core/login.py:171
msgid ""
"No keyring available. Tretlager keeps the Zwift session in the desktop "
"keyring (KWallet or GNOME Keyring), which must be running and unlocked."
msgstr ""
"Kein Schlüsselbund erreichbar. Tretlager speichert die Zwift-Sitzung im "
"Schlüsselbund des Desktops (KWallet bzw. GNOME Schlüsselbund); dieser muss "
"laufen und entsperrt sein."

