#: tretlager/bridge/device.py:170 tretlager/bridge/device.py:175
#: tretlager/bridge/device.py:194
msgid "Bluetooth is stuck – switch Bluetooth off and on again"
msgstr "Bluetooth hängt – Bluetooth kurz aus- und wieder einschalten"

#: tretlager/bridge/device.py:187
msgid ""
"Another Bluetooth device such as headphones is using the adapter – "
"disconnect it or connect it through another adapter"
msgstr ""
"Ein anderes Bluetooth-Gerät wie Kopfhörer belegt den Adapter – trennen oder "
"über einen anderen Adapter verbinden"

#: tretlager/bridge/device.py:214
msgid "Out of range or asleep"
msgstr "Nicht in Reichweite oder schläft"

#: tretlager/bridge/device.py:217
msgid "Device is asleep – pedal briefly or put on the strap"
msgstr "Gerät schläft – kurz treten bzw. Gurt anlegen"

#: tretlager/bridge/device.py:219
msgid "Connection timed out, trying again"
msgstr "Zeitüberschreitung beim Verbinden, neuer Versuch folgt"

#: tretlager/bridge/device.py:221
msgid "Bluetooth is off or the adapter is missing"
msgstr "Bluetooth ist aus oder der Adapter fehlt"

#: tretlager/bridge/device.py:223
msgid "Bluetooth is busy, retrying"
msgstr "Bluetooth ist gerade beschäftigt, neuer Versuch folgt"

#: tretlager/bridge/device.py:225
msgid "Connection attempt aborted, retrying"
msgstr "Verbindungsaufbau abgebrochen, neuer Versuch folgt"

#: tretlager/bridge/device.py:227
msgid "Bluetooth denies access to the device"
msgstr "Bluetooth verweigert den Zugriff auf das Gerät"

#: tretlager/bridge/device.py:230
msgid "Connection failed, retrying"
msgstr "Verbindung fehlgeschlagen, neuer Versuch folgt"

#: tretlager/bridge/device.py:372
msgid ""
"Bluetooth keeps a slow setting for this sensor – unplug and plug in the "
"Bluetooth adapter, or restart the computer"
msgstr ""
"Bluetooth hält für diesen Sensor eine langsame Einstellung fest – Bluetooth-"
"Stick ab- und wieder anstecken oder den Rechner neu starten"

#: tretlager/bridge/device.py:424
msgid ""
"Device offers no supported service (FTMS, Cycling Power, CSC, heart rate)"
msgstr ""
"Gerät bietet keinen unterstützten Dienst (FTMS, Cycling Power, CSC, "
"Herzfrequenz)"

#: tretlager/bridge/device.py:446
msgid "Connection to the device lost"
msgstr "Verbindung zum Gerät verloren"

#: tretlager/bridge/device.py:508
msgid "Device not connected"
msgstr "Gerät nicht verbunden"

#: tretlager/core/bridgectl.py:50
msgid "gdbus is missing (package libglib2.0-bin or glib2)"
msgstr "gdbus fehlt (Paket libglib2.0-bin bzw. glib2)"

#: tretlager/core/bridgectl.py:60
msgid "Bluetooth is switched off. Switch on Bluetooth and try again."
msgstr ""
"Bluetooth ist ausgeschaltet. Bluetooth einschalten und erneut versuchen."

#: tretlager/core/bridgectl.py:62
msgid "Bluetooth is busy. Try again in a few seconds."
msgstr ""
"Bluetooth ist gerade beschäftigt. In ein paar Sekunden erneut versuchen."

#: tretlager/core/bridgectl.py:64
msgid "No Bluetooth adapter found. Plug in or switch on the adapter."
msgstr "Kein Bluetooth-Adapter gefunden. Adapter einstecken bzw. einschalten."

#: tretlager/core/bridgectl.py:66
msgid "The sensor bridge is not responding. It restarts on the next attempt."
msgstr ""
"Die Sensor-Bridge antwortet nicht. Sie startet beim nächsten Versuch neu."

#: tretlager/core/bridgectl.py:67
msgid "The sensor bridge reported an error. Details are in the log."
msgstr "Die Sensor-Bridge meldet einen Fehler. Details stehen im Protokoll."

#: tretlager/core/bridgectl.py:79
msgid "Unexpected response from the bridge"
msgstr "Unerwartete Antwort der Bridge"

#: tretlager/core/bridgectl.py:199
msgid "Keep sensors ready at login"
msgstr "Sensoren beim Anmelden bereithalten"

#: tretlager/core/btcompat.py:74 tretlager/core/btcompat.py:85
msgid "unknown chip"
msgstr "unbekannter Chip"

#: tretlager/core/launch.py:183
msgid "Could not load the KWin script"
msgstr "KWin-Skript ließ sich nicht laden"

#: tretlager/core/launch.py:218
