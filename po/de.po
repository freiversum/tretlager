#~ msgid ""
#~ "Tretlager does not guarantee that the sensor bridge passes power, cadence "
#~ "and heart rate to Zwift correctly. Do not use Tretlager for races or "
#~ "competitions with results."
#~ msgstr ""
#~ "Tretlager garantiert nicht, dass die Sensor-Bridge Leistung, "
#~ "Trittfrequenz und Puls korrekt an Zwift weitergibt. An Rennen und "
#~ "Wettbewerben mit Wertung daher nicht mit Tretlager teilnehmen."

#~ msgid "Only needed at step %1"
#~ msgstr "Erst bei Schritt %1 nötig"

#, python-brace-format
#~ msgid ""
#~ "The Garmin HRM-Pro does not connect to this computer's Bluetooth chip "
#~ "({chip}). It is found, but the connection never completes; range and "
#~ "battery are not the cause. Remedy: plug in a USB Bluetooth dongle and "
#~ "select it as the Bluetooth adapter under Sensors (tested: TP-Link UB500), "
#~ "or use another heart rate strap such as a Wahoo TICKR."
#~ msgstr ""
#~ "Der Garmin HRM-Pro verbindet sich nicht mit dem Bluetooth-Chip dieses "
#~ "Rechners ({chip}). Er wird zwar gefunden, die Verbindung kommt aber nie "
#~ "zustande; an Reichweite oder Batterie liegt das nicht. Abhilfe: einen USB-"
#~ "Bluetooth-Stick anschließen und unter Sensoren als Bluetooth-Adapter "
#~ "wählen (getestet: TP-Link UB500) oder einen anderen Pulsgurt nutzen, etwa "
#~ "einen Wahoo TICKR."

#, python-brace-format
#~ msgid ""
#~ "Does not connect to this Bluetooth chip ({chip}). Remedy: USB Bluetooth "
#~ "dongle"
#~ msgstr ""
#~ "Verbindet sich nicht mit diesem Bluetooth-Chip ({chip}). Abhilfe: USB-"
#~ "Bluetooth-Stick"
